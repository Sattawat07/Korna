# Local development. Copy this file to .env and replace PGPASSWORD.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL on the same machine as Node.js.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=korna
PGUSER=postgres
PGPASSWORD=replace_with_your_password
