# Local development. Copy this file to .env and replace PGPASSWORD.
HOST=127.0.0.1
PORT=3000
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
# Set both to true when HTTPS is terminated by Tailscale Serve.
COOKIE_SECURE=false
TRUST_PROXY=false

# PostgreSQL on the same machine as Node.js.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=korna
PGUSER=postgres
PGPASSWORD=replace_with_your_password
